# ─── Database ────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/invenza
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# ─── JWT ─────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production-min-32-chars-long

# ─── SMTP (for OTP verification emails) ──────────────────────
# Leave SMTP_USER and SMTP_PASSWORD empty in development.
# In dev mode, the OTP code is logged and returned directly in API responses.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@invenza.com
EMAILS_FROM_NAME=Invenza

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Razorpay Payment Gateway (Test Mode) ─────────────────────
RAZORPAY_KEY_ID=rzp_test_TvmS8r4oOuHudO
RAZORPAY_KEY_SECRET=EprfME2muemJ0YxXGGWUh3gq

